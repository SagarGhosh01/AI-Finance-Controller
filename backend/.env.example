# Supabase / PostgreSQL Connection String Example
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials from Database Settings -> Connection String -> URI

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Anthropic LLM API Key (Optional for Tier 2 LLM matching)
# ANTHROPIC_API_KEY=sk-ant-api03-...

PROJECT_NAME=Fincheck AI
AUTH_ENABLED=false
